// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Candle {
  id        String   @id @default(cuid())
  name      String
  city      String?
  message   String?
  createdAt DateTime @default(now())
}

model Tribute {
  id        String        @id @default(cuid())
  name      String
  relation  String
  message   String
  status    TributeStatus @default(PENDING)
  createdAt DateTime      @default(now())
}

enum TributeStatus {
  PENDING
  APPROVED
  REJECTED
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model FuneralInfo {
  id        String   @id @default(cuid())
  date      String
  time      String
  venue     String
  address   String
  mapsUrl   String?
  program   String?
  updatedAt DateTime @updatedAt
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model PageView {
  id        String   @id @default(cuid())
  page      String
  createdAt DateTime @default(now())
}
